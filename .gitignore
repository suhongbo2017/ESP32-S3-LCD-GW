**/*.o
**/*.a
**/*.elf
**/*.map
**/*.bin
**/*.out
**/*.su
**/*.gcno
**/*.gcda

# ---- Python ----
__pycache__/
*.pyc

# ---- 编辑器 / IDE ----
.vscode/
.idea/
*.swp
*.swo

# ---- 其它 ----
*.bak
*~